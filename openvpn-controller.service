[Unit]
Description=OpenVPN Controller Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/etc/openvpn-controller
EnvironmentFile=/etc/openvpn-controller/env
ExecStart=/usr/local/bin/health
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/letsencrypt/live

[Install]
WantedBy=multi-user.target
